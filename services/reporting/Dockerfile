FROM python:3.12-slim

# WeasyPrint needs Pango/Cairo/GDK-Pixbuf for text shaping and rendering --
# this is exactly the macOS native-library problem this Dockerfile exists to
# avoid: on Debian these are a plain apt install, no dyld/SIP complications.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    libffi8 \
    shared-mime-info \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
