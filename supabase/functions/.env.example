# Edge function secrets for local development.
# Copy to supabase/functions/.env (gitignored) and fill in to actually
# exercise the ocr-extract (Document AI) and gemini-analyze (Gemini) calls
# locally; `supabase start` reads this file automatically. In production,
# set these with `supabase secrets set --env-file supabase/functions/.env`
# instead of committing a populated file anywhere.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime -- do not set them here.

# GCP project that owns the Document AI processor.
GOOGLE_CLOUD_PROJECT_ID=

# A Document AI processor ID (a general "Document OCR" or "Form Parser"
# processor is sufficient -- see docs/architecture/phase-5-ocr.md for why
# this doesn't use a custom-trained entity extractor).
DOCUMENT_AI_PROCESSOR_ID=

# Region the processor was created in, e.g. "us" or "eu".
DOCUMENT_AI_LOCATION=us

# The FULL JSON content of a service account key with the Document AI API
# User role, as a single-line string (not a file path -- edge functions
# have no persistent filesystem for GOOGLE_APPLICATION_CREDENTIALS to
# point at). Example: GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# --- Gemini (gemini-analyze function, Phase 6) ---------------------------------
# A Google AI Studio API key (https://aistudio.google.com/apikey) -- unlike
# Document AI, Gemini's Generative Language API authenticates with a plain
# API key, not a service account.
GEMINI_API_KEY=

# Defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash
