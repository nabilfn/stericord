# ==============================================================================
# SteriCord environment template. Copy to .env and fill in real values.
# Never commit a populated .env file.
# ==============================================================================

# Environment: development | staging | production
APP_ENV=development

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage provider abstraction ----------------------------------------------
# supabase | aws | tm_cloud | azure | minio
STORAGE_PROVIDER=supabase

AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TM_STORAGE_ENDPOINT=
TM_STORAGE_BUCKET=
TM_STORAGE_ACCESS_KEY=
TM_STORAGE_SECRET_KEY=

AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=

MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- AI / Vision (Phase 4+, not used in Phase 1-3) -----------------------------
GOOGLE_CLOUD_PROJECT_ID=
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_API_KEY=

# --- Web app (Vite) -------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
